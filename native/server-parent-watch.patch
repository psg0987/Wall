diff --git a/tools/server/main.cpp b/tools/server/main.cpp
index 7f17c56..5f449b3 100644
--- a/tools/server/main.cpp
+++ b/tools/server/main.cpp
@@ -1,5 +1,27 @@
+#if defined(__linux__)
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+#include <unistd.h>
+#endif
+
 int llama_server(int argc, char ** argv);
 
 int main(int argc, char ** argv) {
+#if defined(__linux__)
+    // Raider Tycoon (Android): the app starts this server as a child process. If the app goes away without stopping
+    // it, the server is re-parented; exit then instead of running on in the background.
+    if (std::getenv("LLAMA_PARENT_WATCH")) {
+        const pid_t parent = getppid();
+        std::thread([parent]() {
+            for (;;) {
+                std::this_thread::sleep_for(std::chrono::seconds(1));
+                if (getppid() != parent) {
+                    _exit(0);
+                }
+            }
+        }).detach();
+    }
+#endif
     return llama_server(argc, argv);
 }
